{
  "name": "cloudflare-mcp",
  "version": "2.0.0",
  "description": "Local MCP server exposing Cloudflare DNS, Workers, R2, KV, D1, Queues, Pages, cache, WAF and analytics as tools",
  "private": true,
  "type": "module",
  "bin": {
    "cloudflare-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
